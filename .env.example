# ── 認証（Auth.js / next-auth v5）─────────────────────────────
# セッション JWT の署名に使う秘密鍵。本番では必ず固有の強力な値を設定する。
# 生成例: `openssl rand -base64 32`
AUTH_SECRET="please-generate-a-strong-secret"

# ── 永続化ドライバ ────────────────────────────────────────────
# json   : ローカルの JSON ファイル（既定）
# memory : インメモリ（サーバーレス／デモ。再起動で消える）
# DB_DRIVER="json"

# JSON ドライバのデータ出力先（任意。既定は ./data）
# DATABASE_PATH="./data/tasks.json"

# 本番 Postgres 接続文字列（Phase 2 で導入予定）
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
