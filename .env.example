# ── 認証（Auth.js / next-auth v5）─────────────────────────────
# セッション JWT の署名に使う秘密鍵。本番では必ず固有の強力な値を設定する。
# 生成例: `openssl rand -base64 32`
AUTH_SECRET="please-generate-a-strong-secret"

# ── 永続化ドライバ ────────────────────────────────────────────
# 明示しない場合の優先順位:
#   1. DB_DRIVER          2. DATABASE_URL があれば postgres
#   3. Vercel は memory   4. 既定はローカル json
# DB_DRIVER="json"   # json | memory | postgres

# JSON ドライバのデータ出力先（任意。既定は ./data）
# DATABASE_PATH="./data/tasks.json"

# 本番 Postgres 接続文字列（設定すると postgres ドライバが有効化される）
# 反映手順: スキーマ生成 `npm run db:generate` → 適用 `npm run db:migrate`
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
